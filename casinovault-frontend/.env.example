# Public (browser)
NEXT_PUBLIC_SOLANA_RPC_URL=https://api.devnet.solana.com
NEXT_PUBLIC_SOLANA_CLUSTER=devnet
# Optional: your own deployment's program ID (defaults to the devnet demo)
# NEXT_PUBLIC_VAULT_PROGRAM_ID=

# Server only — JSON array or base58 secret of the on-chain admin keypair
ADMIN_SECRET_KEY=

# The demo /api/withdraw route has NO user balances and will co-sign for anyone.
# It returns 501 unless this is exactly "true". Devnet demos only — never real funds.
VAULT_DEMO_UNSAFE_WITHDRAW=false
# Per-request cap when the demo route is enabled (SOL, default 0.1)
VAULT_DEMO_MAX_WITHDRAW_SOL=0.1
