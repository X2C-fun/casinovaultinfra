{
  "name": "casino-vault",
  "version": "0.1.1",
  "private": true,
  "license": "MIT",
  "description": "Anchor program that custodies player SOL for the casino backend.",
  "scripts": {
    "build": "anchor build",
    "test": "anchor test",
    "test:skip-build": "anchor test --skip-build",
    "deploy:devnet": "anchor deploy -p casino_vault --provider.cluster devnet",
    "read": "ts-node --compiler-options '{\"module\":\"commonjs\"}' scripts/read.ts",
    "initialize": "ts-node --compiler-options '{\"module\":\"commonjs\"}' scripts/initialize.ts",
    "deposit": "ts-node --compiler-options '{\"module\":\"commonjs\"}' scripts/deposit.ts",
    "withdraw": "ts-node --compiler-options '{\"module\":\"commonjs\"}' scripts/withdraw.ts",
    "set-paused": "ts-node --compiler-options '{\"module\":\"commonjs\"}' scripts/set_paused.ts",
    "lint": "prettier --check \"tests/**/*.ts\" \"scripts/**/*.ts\"",
    "lint:fix": "prettier --write \"tests/**/*.ts\" \"scripts/**/*.ts\""
  },
  "dependencies": {
    "@coral-xyz/anchor": "^0.32.1",
    "@solana/web3.js": "^1.98.4"
  },
  "devDependencies": {
    "@types/bn.js": "^5.2.0",
    "@types/chai": "^4.3.20",
    "@types/mocha": "^10.0.10",
    "@types/node": "^22.15.3",
    "chai": "^4.5.0",
    "mocha": "^10.8.2",
    "prettier": "^3.6.2",
    "ts-mocha": "^11.1.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.2"
  }
}
