# --- Casino Vault reference backend ---

# Solana RPC (devnet).
RPC_URL=https://api.devnet.solana.com

# Vault program ID. Omit to use the SDK's canonical devnet deployment.
# VAULT_PROGRAM_ID=EXTH5XRAqc45efhoL5UjwhhLFV4smgaB4m6QVG74Vqa7

# Admin key that co-signs every withdrawal. JSON array (keys/admin.json
# contents) OR a base58 string. SERVER-SIDE ONLY — never NEXT_PUBLIC_*.
# Not needed by `npm run reconcile` or `npm run incident`.
ADMIN_SECRET_KEY=[12,34,56,...]

# Ledger: "sqlite" (durable, default). The API, the listener, the reconcile job
# and the operator CLIs MUST share the same DB_PATH.
LEDGER=sqlite
DB_PATH=casinovault.db
# "memory" is refused unless NODE_ENV=test or this is set (it loses holds and
# the incident kill-switch on restart, and is not shared between processes).
# ALLOW_MEMORY_LEDGER=true

# HTTP API. Binds loopback by default; set HOST=0.0.0.0 only behind your own
# authenticating gateway.
PORT=8787
HOST=127.0.0.1

# Every route except /health requires `Authorization: Bearer <API_TOKEN>`
# (at least 16 characters, e.g. `openssl rand -hex 32`; values starting with
# "change-me" are refused). Required unless ALLOW_UNAUTHENTICATED=true, which is
# for local development only and is refused unless HOST is loopback
# (127.0.0.1, ::1, localhost). A shared token is NOT player authentication: a
# real deployment must authenticate the player and derive the owner from the
# session, never from the request body.
API_TOKEN=
# ALLOW_UNAUTHENTICATED=true

# Optional priority fee on withdraw transactions (the user pays it, so it is
# bounded by the SDK's MAX_PRIORITY_FEE_LAMPORTS).
# COMPUTE_UNIT_PRICE_MICRO_LAMPORTS=1000
# COMPUTE_UNIT_LIMIT=60000

# Listener start point. With no stored cursor the listener REFUSES to start
# unless one of these is set (it never replays the whole program history).
# v0.1 events do not decode with the v0.2 IDL.
# Slot of the v0.1 -> v0.2 upgrade; program transactions at or before it are skipped.
# UPGRADE_SLOT=123456789
# Signature to start after when the ledger has no cursor yet (e.g. the upgrade tx).
# START_AFTER_SIGNATURE=5Kd3...

# Listener: stop and alert (instead of collecting forever) when more than this
# many signatures are pending in one cycle.
# LISTENER_MAX_BACKLOG=10000

# Reconciliation job only (opens DB_PATH read-only; fails if it does not exist):
# house lamports in the pool that the ledger cannot
# see (e.g. seeded with a plain System transfer). Admin-wallet deposits and
# house withdrawals are already tracked by the ledger.
# HOUSE_BANKROLL_LAMPORTS=0
