{
  "name": "@x2c-fun/casinovault-sdk",
  "version": "0.1.0",
  "description": "TypeScript SDK for the Casino Vault Solana program: typed IDL, PDAs, instruction builders, a safe withdraw-transaction builder, event decoding, and pool reconciliation.",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "sideEffects": false,
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/X2C-fun/casinovaultinfra.git",
    "directory": "packages/sdk"
  },
  "keywords": [
    "solana",
    "anchor",
    "casino",
    "vault",
    "sdk",
    "web3"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.test.json",
    "test": "vitest run",
    "smoke": "npm run build && node -e \"import('./dist/index.js').then(m=>{if(!m.buildWithdrawTransaction)process.exit(1)})\" && node -e \"const m=require('./dist/index.cjs');if(!m.buildWithdrawTransaction)process.exit(1)\"",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "buffer": "^6.0.3"
  },
  "peerDependencies": {
    "@coral-xyz/anchor": "^0.32.1",
    "@solana/web3.js": "^1.98.4"
  },
  "devDependencies": {
    "@coral-xyz/anchor": "^0.32.1",
    "@solana/web3.js": "^1.98.4",
    "@types/node": "^22.20.5",
    "tsup": "^8.5.0",
    "typescript": "^5.9.2",
    "vitest": "^2.1.9"
  }
}
